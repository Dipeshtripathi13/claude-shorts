{
  "manifest_version": 3,
  "name": "Tangent \u2014 Explainers for AI Chats",
  "version": "1.0.0",
  "description": "Offers a short explainer video for whatever you just asked your AI assistant. Nothing is searched until you click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Tangent \u2014 show or hide the panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "src/ui/options.html",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://aistudio.google.com/*",
    "https://grok.com/*",
    "https://chat.deepseek.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://chat.mistral.ai/*",
    "https://copilot.microsoft.com/*",
    "https://poe.com/*",
    "https://chat.qwen.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://huggingface.co/chat/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://chat.qwen.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://huggingface.co/chat/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/panel.html"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://poe.com/*",
        "https://chat.qwen.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://huggingface.co/*"
      ]
    }
  ]
}
